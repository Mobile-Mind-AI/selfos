        mock_query = Mock()
        mock_query.limit.return_value.all.return_value = mock_entries
        self.mock_db.query.return_value.options.return_value.filter.return_value.order_by.return_value = mock_query

        # Act
        result = JournalService.search_entries(self.mock_db, self.user_id, search_term)

