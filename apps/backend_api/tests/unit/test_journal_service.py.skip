        assert "Goal with id 999 not found or access denied" in str(exc_info.value)

    def test_create_entry_with_invalid_task(self):
        """Test journal entry creation with invalid task ID"""
        # Arrange
        entry_data = JournalEntryCreate(
            content="Test content",
