    def test_get_entry_statistics(self):
        """Test getting journal entry statistics"""
        # Arrange
        from sqlalchemy import func

        # Mock total entries count
        self.mock_db.query.return_value.filter.return_value.count.side_effect = [
            10,  # total_entries
            3,   # with_project
            4,   # with_goal
            2,   # with_task
            5    # recent_entries
        ]

        # Mock average content length
        self.mock_db.query.return_value.filter.return_value.scalar.return_value = 150.5

        # Mock oldest and newest entry dates
        oldest_date = datetime.utcnow() - timedelta(days=30)
        newest_date = datetime.utcnow()
        self.mock_db.query.return_value.filter.return_value.order_by.return_value.first.side_effect = [
            (oldest_date,),  # oldest_entry
            (newest_date,)   # newest_entry
        ]

        # Act
        result = JournalService.get_entry_statistics(self.mock_db, self.user_id)

        # Assert
        assert result["total_entries"] == 10
        assert result["entries_with_project"] == 3
        assert result["entries_with_goal"] == 4
        assert result["entries_with_task"] == 2
        assert result["standalone_entries"] == 1  # 10 - 3 - 4 - 2 = 1
        assert result["recent_entries_30d"] == 5
        assert result["average_content_length"] == 150.5
        assert result["oldest_entry_date"] == oldest_date
        assert result["newest_entry_date"] == newest_date

    def test_get_entry_statistics_empty(self):
        """Test getting statistics when no entries exist"""
        # Arrange
        self.mock_db.query.return_value.filter.return_value.count.return_value = 0
        self.mock_db.query.return_value.filter.return_value.scalar.return_value = None
        self.mock_db.query.return_value.filter.return_value.order_by.return_value.first.return_value = None

        # Act
        result = JournalService.get_entry_statistics(self.mock_db, self.user_id)

        # Assert
        assert result["total_entries"] == 0
        assert result["entries_with_project"] == 0
        assert result["entries_with_goal"] == 0
        assert result["entries_with_task"] == 0
        assert result["standalone_entries"] == 0
        assert result["recent_entries_30d"] == 0
        assert result["average_content_length"] == 0
        assert result["oldest_entry_date"] is None
        assert result["newest_entry_date"] is None
