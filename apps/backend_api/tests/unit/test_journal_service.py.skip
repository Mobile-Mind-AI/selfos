    def test_create_entry_standalone(self):
        """Test creating standalone journal entry without associations"""
        # Arrange
        entry_data = JournalEntryCreate(content="Standalone entry")

        # Mock entry creation
        expected_entry = JournalEntry(
            id=1,
            user_id=self.user_id,
            content=entry_data.content,
            project_id=None,
            goal_id=None,
            task_id=None
        )

        self.mock_db.add = Mock()
        self.mock_db.commit = Mock()
        self.mock_db.refresh = Mock()

        # Act
        result = JournalService.create_entry(self.mock_db, self.user_id, entry_data)

        # Assert
        assert result.user_id == self.user_id
        assert result.content == entry_data.content
        assert result.project_id is None
        assert result.goal_id is None
        assert result.task_id is None

    def test_get_entry_success(self):
        """Test successful journal entry retrieval"""
        # Arrange
        entry_id = 1
        expected_entry = JournalEntry(
            id=entry_id,
            user_id=self.user_id,
            content="Test content"
        )

        self.mock_db.query.return_value.options.return_value.filter.return_value.first.return_value = expected_entry

        # Act
        result = JournalService.get_entry(self.mock_db, self.user_id, entry_id)

        # Assert
        assert result == expected_entry

    def test_get_entry_not_found(self):
        """Test journal entry retrieval when entry not found"""
        # Arrange
        entry_id = 999
        self.mock_db.query.return_value.options.return_value.filter.return_value.first.return_value = None

        # Act
        result = JournalService.get_entry(self.mock_db, self.user_id, entry_id)

        # Assert
        assert result is None

    def test_get_entries_with_filters(self):
        """Test getting journal entries with various filters"""
        # Arrange
        mock_entries = [
            JournalEntry(id=1, user_id=self.user_id, content="Entry 1"),
            JournalEntry(id=2, user_id=self.user_id, content="Entry 2")
        ]

        # Set up the full mock chain for SQLAlchemy query
        mock_query = Mock()
        mock_query.offset.return_value.limit.return_value.all.return_value = mock_entries

        # Chain: query -> options -> filter (user_id) -> filter (project_id) -> order_by -> offset -> limit -> all
        self.mock_db.query.return_value.options.return_value.filter.return_value.filter.return_value.order_by.return_value = mock_query

        # Act
        result = JournalService.get_entries(
            db=self.mock_db,
            user_id=self.user_id,
            project_id=1,
            limit=10,
            offset=0
        )

        # Assert
        assert len(result) == 2
        assert result == mock_entries

    def test_get_entries_with_search(self):
        """Test getting journal entries with content search"""
        # Arrange
        mock_entries = [JournalEntry(id=1, user_id=self.user_id, content="Searched content")]

        # Set up the full mock chain for SQLAlchemy query with search filter
        mock_query = Mock()
        mock_query.offset.return_value.limit.return_value.all.return_value = mock_entries

        # Chain: query -> options -> filter (user_id) -> filter (search) -> order_by -> offset -> limit -> all
        self.mock_db.query.return_value.options.return_value.filter.return_value.filter.return_value.order_by.return_value = mock_query

        # Act
        result = JournalService.get_entries(
            db=self.mock_db,
            user_id=self.user_id,
            search_content="search"
        )

        # Assert
        assert len(result) == 1
        assert result[0].content == "Searched content"

    def test_get_entries_for_parent_project(self):
        """Test getting journal entries for specific project"""
        # Arrange
        mock_entries = [JournalEntry(id=1, user_id=self.user_id, project_id=1)]

        mock_query = Mock()
        mock_query.options.return_value.order_by.return_value.all.return_value = mock_entries
        self.mock_db.query.return_value.filter.return_value.filter.return_value = mock_query

        # Act
        result = JournalService.get_entries_for_parent(
            db=self.mock_db,
            user_id=self.user_id,
            parent_type="project",
            parent_id=1
        )

        # Assert
        assert len(result) == 1
        assert result[0].project_id == 1

    def test_get_entries_for_parent_invalid_type(self):
        """Test getting journal entries with invalid parent type"""
        # Act & Assert
        with pytest.raises(ValueError) as exc_info:
            JournalService.get_entries_for_parent(
                db=self.mock_db,
                user_id=self.user_id,
                parent_type="invalid",
                parent_id=1
            )

        assert "Invalid parent_type: invalid" in str(exc_info.value)

    def test_update_entry_success(self):
        """Test successful journal entry update"""
        # Arrange
        entry_id = 1
        update_data = JournalEntryUpdate(content="Updated content")

        existing_entry = JournalEntry(
            id=entry_id,
            user_id=self.user_id,
            content="Original content",
            version=1
        )

        self.mock_db.query.return_value.filter.return_value.first.return_value = existing_entry
        self.mock_db.commit = Mock()
        self.mock_db.refresh = Mock()

        # Act
        result = JournalService.update_entry(self.mock_db, self.user_id, entry_id, update_data)

        # Assert
        assert result.content == "Updated content"
        assert result.version == 2  # Version should be incremented
        self.mock_db.commit.assert_called_once()
        self.mock_db.refresh.assert_called_once()

    def test_update_entry_not_found(self):
        """Test updating journal entry that doesn't exist"""
        # Arrange
        entry_id = 999
        update_data = JournalEntryUpdate(content="Updated content")

        self.mock_db.query.return_value.filter.return_value.first.return_value = None

        # Act
        result = JournalService.update_entry(self.mock_db, self.user_id, entry_id, update_data)

        # Assert
        assert result is None

    def test_delete_entry_success(self):
        """Test successful journal entry deletion"""
        # Arrange
        entry_id = 1
        existing_entry = JournalEntry(id=entry_id, user_id=self.user_id)

        self.mock_db.query.return_value.filter.return_value.first.return_value = existing_entry
        self.mock_db.delete = Mock()
        self.mock_db.commit = Mock()

        # Act
        result = JournalService.delete_entry(self.mock_db, self.user_id, entry_id)

        # Assert
        assert result is True
        self.mock_db.delete.assert_called_once_with(existing_entry)
        self.mock_db.commit.assert_called_once()

    def test_delete_entry_not_found(self):
        """Test deleting journal entry that doesn't exist"""
        # Arrange
        entry_id = 999
        self.mock_db.query.return_value.filter.return_value.first.return_value = None

        # Act
        result = JournalService.delete_entry(self.mock_db, self.user_id, entry_id)

        # Assert
        assert result is False
        self.mock_db.delete.assert_not_called()
        self.mock_db.commit.assert_not_called()

