    def test_get_recent_entries(self):
        """Test getting recent journal entries"""
        # Arrange
        mock_entries = [
            JournalEntry(id=1, user_id=self.user_id, created_at=datetime.utcnow()),
            JournalEntry(id=2, user_id=self.user_id, created_at=datetime.utcnow() - timedelta(days=1))
        ]

        mock_query = Mock()
        mock_query.limit.return_value.all.return_value = mock_entries
        self.mock_db.query.return_value.options.return_value.filter.return_value.order_by.return_value = mock_query

        # Act
        result = JournalService.get_recent_entries(self.mock_db, self.user_id, days=7, limit=10)

        # Assert
        assert len(result) == 2
        assert result == mock_entries

    def test_search_entries(self):
        """Test searching journal entries"""
