"""Unit tests for Journal Service."""

import pytest
from datetime import datetime, timedelta
from sqlalchemy.orm import Session
from unittest.mock import Mock

from models import JournalEntry, User, Project, Goal, Task, LifeArea
from schemas import JournalEntryCreate, JournalEntryUpdate
from services.journal_service import JournalService


class TestJournalService:
    """Test suite for JournalService"""

    def setup_method(self):
        """Set up test fixtures"""
        self.user_id = "test-user-123"
        self.mock_db = Mock(spec=Session)

    def test_create_entry_success(self):
        """Test successful journal entry creation"""
        # Arrange
        entry_data = JournalEntryCreate(
            content="Test journal entry content",
            project_id=1,
            goal_id=2,
            task_id=3
        )

        # Mock database queries for validation
        mock_project = Project(id=1, user_id=self.user_id)
        mock_goal = Goal(id=2, user_id=self.user_id)
        mock_task = Task(id=3, user_id=self.user_id)

        self.mock_db.query.return_value.filter.return_value.first.side_effect = [
            mock_project, mock_goal, mock_task
        ]

        # Mock entry creation
        expected_entry = JournalEntry(
            id=1,
            user_id=self.user_id,
            content=entry_data.content,
            project_id=entry_data.project_id,
            goal_id=entry_data.goal_id,
            task_id=entry_data.task_id
        )

        self.mock_db.add = Mock()
        self.mock_db.commit = Mock()
        self.mock_db.refresh = Mock()

        # Act
        result = JournalService.create_entry(self.mock_db, self.user_id, entry_data)

        # Assert
        assert result.user_id == self.user_id
        assert result.content == entry_data.content
        assert result.project_id == entry_data.project_id
        assert result.goal_id == entry_data.goal_id
        assert result.task_id == entry_data.task_id
        self.mock_db.add.assert_called_once()
        self.mock_db.commit.assert_called_once()
        self.mock_db.refresh.assert_called_once()

    def test_create_entry_with_invalid_project(self):
        """Test journal entry creation with invalid project ID"""
        # Arrange
        entry_data = JournalEntryCreate(
            content="Test content",
            project_id=999  # Invalid project ID
        )

        # Mock database query to return None (project not found)
        self.mock_db.query.return_value.filter.return_value.first.return_value = None

        # Act & Assert
        with pytest.raises(ValueError) as exc_info:
            JournalService.create_entry(self.mock_db, self.user_id, entry_data)

        assert "Project with id 999 not found or access denied" in str(exc_info.value)

